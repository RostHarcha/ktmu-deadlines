#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BACKEND_DIR="$(dirname "$SCRIPT_DIR")"
PROJECT_DIR="$(dirname "$BACKEND_DIR")"

ENVIRONMENT=development

if [ "${1:-}" = "--prod" ]; then
    ENVIRONMENT=production
    shift
fi

. "$PROJECT_DIR/scripts/lib/compose-env.sh"

if [ "$ENVIRONMENT" = development ]; then
    exec docker compose \
        --env-file "$ENV_FILE" \
        -f "$PROJECT_DIR/compose.yaml" \
        -f "$COMPOSE_OVERRIDE" \
        run --rm \
        --no-deps \
        --user "$(id -u):$(id -g)" \
        migrate python -m alembic "$@"
fi

exec docker compose \
    --env-file "$ENV_FILE" \
    -f "$PROJECT_DIR/compose.yaml" \
    -f "$COMPOSE_OVERRIDE" \
    run --rm \
    --no-deps \
    migrate python -m alembic "$@"
